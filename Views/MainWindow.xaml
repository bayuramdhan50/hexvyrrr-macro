<Window x:Class="PbRecoil.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PbRecoil.Views"
        Title="Hexvyrr Macro — Point Blank Precision Engine"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Width="395" Height="Auto" SizeToContent="Height"
        MinWidth="370"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="30" Top="30"
        ShowInTaskbar="True">

    <Window.Resources>
        <converters:StatusBorderConverter x:Key="StatusBorderConverter"/>
        <converters:StatusBgConverter     x:Key="StatusBgConverter"/>
        <converters:StatusTextConverter   x:Key="StatusTextConverter"/>
        <converters:FiringColorConverter  x:Key="FiringColorConverter"/>
        <converters:PresetActiveBgConverter x:Key="PresetActiveBgConv"/>
        <converters:PresetActiveFgConverter x:Key="PresetActiveFgConv"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter     x:Key="BoolToVis"/>

        <!-- Cyber Action Button Style -->
        <Style x:Key="CyberActionBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#131D2B"/>
            <Setter Property="BorderBrush" Value="#22334A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Primary Button Style -->
        <Style x:Key="CyberPrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#182A2E"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root Border with Glassmorphism Effect -->
    <Border CornerRadius="14"
            BorderThickness="1.5"
            BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"
            Margin="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4090E17" Offset="0"/>
                <GradientStop Color="#F40E1624" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#000000" Opacity="0.92"/>
        </Border.Effect>

        <StackPanel>
            <!-- ── TITLE BAR (Draggable & with App Logo) ────────────────── -->
            <Border CornerRadius="14,14,0,0"
                    Padding="12,10,12,10"
                    Background="#141B26"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App Logo Image -->
                        <Border Width="22" Height="22" CornerRadius="5" Margin="0,0,8,0" ClipToBounds="True" Background="#0C121C">
                            <Image Source="pack://application:,,,/Resources/app_logo.png" Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock Text="HEXVYRR MACRO" FontWeight="Black" FontSize="13"
                                   Foreground="#00F0FF" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="V2" FontSize="9" FontWeight="Bold" Foreground="#00FF88" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Control Buttons (Check Update, Minimize & Close) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="24" Height="24" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#00F0FF" FontSize="11" Cursor="Hand"
                                ToolTip="Cek Pembaruan Versi"
                                Click="CheckUpdateButton_Click">
                            <TextBlock Text="🚀" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Content="—" Width="24" Height="24" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8B949E" FontSize="11" Cursor="Hand"
                                ToolTip="Minimize ke System Tray"
                                Click="MinimizeButton_Click"/>

                        <Button Content="✕" Width="24" Height="24"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8B949E" FontSize="12" Cursor="Hand"
                                ToolTip="Tutup Aplikasi"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── NEON DIVIDER ────────────────────────────────────────── -->
            <Rectangle Height="1" Fill="#1E2D42"/>

            <!-- ── MAIN CONTENT BODY ───────────────────────────────────── -->
            <StackPanel Margin="14,12,14,14">

                <!-- ── STATUS HERO CARD ────────────────────────────────── -->
                <Border CornerRadius="8"
                        Background="#0D1420"
                        BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Firing Pulse Dot -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="#141E2D" BorderBrush="#25354D" BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Width="14" Height="14"
                                     Fill="{Binding IsFiring, Converter={StaticResource FiringColorConverter}}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                      Color="{Binding IsFiring, Converter={StaticResource FiringColorConverter}}"
                                                      Opacity="0.95"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>

                        <!-- Status Texts -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontWeight="Bold" FontSize="10.5" Foreground="#E6EDF3"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Hexvyrr Sequence Loop — Repeat While Holding"
                                       FontSize="9" Foreground="#6E7681" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Toggle Button F1 -->
                        <Button Grid.Column="2"
                                Content="{Binding StatusHeader}"
                                Width="50" Height="26" Margin="8,0,0,0"
                                Command="{Binding ToggleEngineCommand}"
                                Style="{StaticResource CyberPrimaryBtn}"
                                Background="{Binding IsEngineActive, Converter={StaticResource StatusBgConverter}}"
                                Foreground="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}"
                                BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"/>
                    </Grid>
                </Border>

                <!-- ── SECTION 1: MACRO SEQUENCE VISUALIZATION ──────── -->
                <Border CornerRadius="7" Background="#0C121C" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚡ MACRO TIMING SEQUENCE" FontSize="10" FontWeight="Black" Foreground="#00F0FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="[F3] Live HUD" FontSize="9" FontWeight="Bold" Foreground="#00FF88" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Visual Sequence Flow -->
                        <Border Background="#080C14" CornerRadius="6" Padding="8,6" Margin="0,0,0,8" BorderBrush="#162233" BorderThickness="1">
                            <Grid HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Action 1: LMB Down -->
                                    <Border Background="#5A0D1B" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="LMB" FontWeight="Bold" FontSize="9" Foreground="#FFFFFF"/>
                                            <TextBlock Text=" ↓" FontWeight="Black" FontSize="8" Foreground="#FF8899"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Delay 1 -->
                                    <StackPanel VerticalAlignment="Center" Margin="5,0">
                                        <TextBlock Text="{Binding HoldMs, StringFormat={}{0} ms}" FontSize="8.5" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Center"/>
                                        <Rectangle Height="1" Width="28" Fill="#00F0FF" Margin="0,1"/>
                                    </StackPanel>

                                    <!-- Action 2: LMB Up -->
                                    <Border Background="#5A0D1B" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="LMB" FontWeight="Bold" FontSize="9" Foreground="#FFFFFF"/>
                                            <TextBlock Text=" ↑" FontWeight="Black" FontSize="8" Foreground="#88FF99"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Delay 2 -->
                                    <StackPanel VerticalAlignment="Center" Margin="5,0">
                                        <TextBlock Text="{Binding ReleaseMs, StringFormat={}{0} ms}" FontSize="8.5" FontWeight="Bold" Foreground="#00FF88" HorizontalAlignment="Center"/>
                                        <Rectangle Height="1" Width="28" Fill="#00FF88" Margin="0,1"/>
                                    </StackPanel>

                                    <!-- Loop Icon -->
                                    <Border Background="#162233" CornerRadius="4" Padding="5,3" VerticalAlignment="Center">
                                        <TextBlock Text="↻ LOOP" FontSize="8" FontWeight="Black" Foreground="#8B949E"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live Values Display -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Hold Duration: " FontSize="9.5" Foreground="#8B949E"/>
                                <TextBlock Text="{Binding HoldMs, StringFormat={}{0} ms}" FontSize="9.5" FontWeight="Bold" Foreground="#00F0FF"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Release Interval: " FontSize="9.5" Foreground="#8B949E"/>
                                <TextBlock Text="{Binding ReleaseMs, StringFormat={}{0} ms}" FontSize="9.5" FontWeight="Bold" Foreground="#00FF88"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── SECTION 2: DISPLAY & CROSSHAIR (TERPISAH) ───────── -->
                <Border CornerRadius="7" Background="#0C121C" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎯 DISPLAY &amp; CROSSHAIR" FontSize="10" FontWeight="Black" Foreground="#00FF88" Margin="0,0,0,6"/>
                        
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Adaptive Center Crosshair Dot" FontSize="10" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                                <TextBlock Text="Posisi presisi di tengah layar Point Blank" FontSize="9" Foreground="#6E7681" Margin="0,1,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                     Content="{Binding CrosshairStatusLabel, StringFormat=DOT: {0}}"
                                     Height="24" Width="70"
                                     Command="{Binding ToggleCrosshairCommand}"
                                     Style="{StaticResource CyberActionBtn}"
                                     Foreground="{Binding IsCrosshairVisible, Converter={StaticResource PresetActiveFgConv}}"
                                     Background="{Binding IsCrosshairVisible, Converter={StaticResource PresetActiveBgConv}}"
                                     BorderBrush="#2A3B52"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── SECTION 3: CONFIG PROFILE MANAGEMENT (SAVE/LOAD/DEFAULT) ── -->
                <Border CornerRadius="7" Background="#0C121C" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📁 CONFIG PROFILE" FontSize="10" FontWeight="Black" Foreground="#FF6BFF" Margin="0,0,0,6"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Save Config Button -->
                            <Button Grid.Column="0"
                                    Content="💾 SAVE"
                                    Margin="0,0,3,0"
                                    Command="{Binding SaveConfigCommand}"
                                    Style="{StaticResource CyberPrimaryBtn}"
                                    ToolTip="Simpan konfigurasi saat ini ke hexvyrr_config.json"/>

                            <!-- Load Config Button -->
                            <Button Grid.Column="1"
                                    Content="📂 LOAD"
                                    Margin="3,0,3,0"
                                    Command="{Binding LoadConfigCommand}"
                                    Style="{StaticResource CyberActionBtn}"
                                    ToolTip="Muat konfigurasi dari hexvyrr_config.json"/>

                            <!-- Default Config Button -->
                            <Button Grid.Column="2"
                                    Content="↺ DEFAULT"
                                    Margin="3,0,0,0"
                                    Command="{Binding ResetDefaultConfigCommand}"
                                    Style="{StaticResource CyberActionBtn}"
                                    ToolTip="Kembalikan semua pengaturan ke nilai default pabrik (20ms/0ms)"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── SHORTCUT GUIDELINE FOOTER ───────────────────────── -->
                <Border Background="#090E17" CornerRadius="6" Padding="8,6" BorderBrush="#192333" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="[ F1 ]" FontWeight="Bold" FontSize="10" Foreground="#00F0FF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Engine On/Off" FontSize="8.5" Foreground="#6E7681" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="[ F2 ]" FontWeight="Bold" FontSize="10" Foreground="#00FF88" HorizontalAlignment="Center"/>
                            <TextBlock Text="HUD Overlay" FontSize="8.5" Foreground="#6E7681" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="[ F3 ]" FontWeight="Bold" FontSize="10" Foreground="#FF6BFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Config Menu" FontSize="8.5" Foreground="#6E7681" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>

