<Window x:Class="PbRecoil.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PbRecoil.Views"
        Title="PB Recoil Control Hub - Point Blank"
        Height="720" Width="1050"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        Foreground="#F0F6FC">

    <Window.Resources>
        <converters:StatusBorderConverter x:Key="StatusBorderConverter"/>
        <converters:StatusBgConverter x:Key="StatusBgConverter"/>
        <converters:StatusTextConverter x:Key="StatusTextConverter"/>

        <!-- Custom Card Style -->
        <Style x:Key="WeaponCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#00F0FF" Width="4" Height="28" CornerRadius="2" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="POINT BLANK RECOIL CONTROL" FontWeight="ExtraBold" FontSize="16" Foreground="#00F0FF"/>
                        <TextBlock Text="High-Precision Mouse Drag Engine // Fullscreen Support" FontSize="10" Foreground="#8B949E"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Action Buttons & Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- HUD Overlay Toggle -->
                    <Button Command="{Binding ToggleOverlayCommand}"
                            Padding="12,6" Margin="0,0,8,0"
                            Background="#21262D" Foreground="#E6EDF3" BorderBrush="#30363D" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HUD Overlay [F8]" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- Master Engine Toggle Button -->
                    <Button Command="{Binding ToggleEngineCommand}"
                            Padding="16,8" Cursor="Hand"
                            Background="{Binding IsEngineActive, Converter={StaticResource StatusBgConverter}}"
                            BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"
                            BorderThickness="1.5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}"/>
                            <TextBlock Text="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}" FontWeight="Bold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="[F6] ENGINE OFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEngineActive}" Value="True">
                                                <Setter Property="Text" Value="[F6] ENGINE ON (ACTIVE)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <!-- Left: Category Tabs & Weapon List (CRUD) -->
                <ColumnDefinition Width="420"/>
                <!-- Right: Active Preset Real-time Tuner & Customizer -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Categories, Search, and Weapon List -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search and Filter Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D">
                        <TextBox.Resources>
                            <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Text="🔍 Cari nama senjata..." Foreground="#6E7681" Margin="4,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Category Filters (Horizontal Wrap) -->
                <ComboBox Grid.Row="1" ItemsSource="{Binding CategoryFilterList}"
                          SelectedValue="{Binding SelectedCategoryFilter}"
                          SelectedValuePath="Category"
                          DisplayMemberPath="DisplayName"
                          Padding="8,6" Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="0,0,0,12"/>

                <!-- Weapon Presets ListBox -->
                <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="6">
                    <ListBox ItemsSource="{Binding FilteredPresets}"
                             SelectedItem="{Binding SelectedPreset}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WeaponCardStyle}" Margin="2,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#F0F6FC"/>
                                                <Border Background="#21262D" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#8B949E"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#8B949E" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding VerticalRecoil, StringFormat='V: {0}'}" FontWeight="Bold" FontSize="11" Foreground="#00FF88" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DelayMs, StringFormat='{}{0}ms'}" FontSize="9" Foreground="#6E7681" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Left Action Toolbar (CRUD Buttons) -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding AddPresetCommand}"
                            Content="+ Tambah Preset Senjata" Padding="10,6" Margin="0,0,6,0"
                            Background="#00F0FF" Foreground="#0D1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                    <Button Grid.Column="1" Command="{Binding DeletePresetCommand}"
                            Content="🗑️ Hapus" Padding="10,6"
                            Background="#21262D" Foreground="#FF3366" BorderBrush="#30363D" Cursor="Hand"/>
                </Grid>
            </Grid>

            <!-- RIGHT COLUMN: Active Preset Details & Live Tuning Panel -->
            <Border Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Selected Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LIVE TUNING &amp; PARAMETER RECOIL" FontWeight="Bold" FontSize="14" Foreground="#00FF88"/>
                                <TextBlock Text="Sesuaikan kekuatan tarikan mouse secara langsung saat in-game" FontSize="11" Foreground="#8B949E"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding SaveChangesCommand}"
                                    Content="💾 Simpan Preset (Save JSON)" Padding="12,6"
                                    Background="#00FF88" Foreground="#0D1117" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <Border Height="1" Background="#30363D" Margin="0,0,0,16"/>

                        <!-- Weapon Name and Category Header -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Nama Preset Senjata:" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedPreset.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Kategori Senjata:" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedPreset.Category, Mode=OneWay}" IsReadOnly="True"
                                         Padding="8,6" Background="#0D1117" Foreground="#8B949E" BorderBrush="#30363D"/>
                            </StackPanel>
                        </Grid>

                        <!-- SLIDERS: Vertical Recoil Drag -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vertical Recoil Drag (Y Axis - Tarikan ke Bawah):" FontWeight="SemiBold" Foreground="#00FF88"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPreset.VerticalRecoil, StringFormat='{}{0} px'}" FontWeight="Bold" Foreground="#00FF88"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="25" Value="{Binding SelectedPreset.VerticalRecoil, UpdateSourceTrigger=PropertyChanged}"
                                SmallChange="1" LargeChange="2" Margin="0,0,0,16"/>

                        <!-- SLIDERS: Horizontal Recoil Bias -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Horizontal Recoil Bias (X Axis - Kompensasi Kiri/Kanan):" FontWeight="SemiBold" Foreground="#00F0FF"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPreset.HorizontalRecoil, StringFormat='{}{0} px'}" FontWeight="Bold" Foreground="#00F0FF"/>
                        </Grid>
                        <Slider Minimum="-10" Maximum="10" Value="{Binding SelectedPreset.HorizontalRecoil, UpdateSourceTrigger=PropertyChanged}"
                                SmallChange="1" LargeChange="2" Margin="0,0,0,16"/>

                        <!-- SLIDERS: Fire Interval Delay -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fire Interval Delay (Kecepatan Tembak):" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPreset.DelayMs, StringFormat='{}{0} ms'}" FontWeight="Bold" Foreground="#E6EDF3"/>
                        </Grid>
                        <Slider Minimum="2" Maximum="60" Value="{Binding SelectedPreset.DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                SmallChange="1" LargeChange="5" Margin="0,0,0,16"/>

                        <!-- SLIDERS: Smooth Interpolation Step -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Smooth Interpolation (Langkah Tarikan):" FontWeight="SemiBold" Foreground="#8B949E"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPreset.SmoothStep, StringFormat='{}{0} steps'}" FontWeight="Bold" Foreground="#8B949E"/>
                        </Grid>
                        <Slider Minimum="1" Maximum="10" Value="{Binding SelectedPreset.SmoothStep, UpdateSourceTrigger=PropertyChanged}"
                                SmallChange="1" Margin="0,0,0,16"/>

                        <!-- SLIDERS: Natural Humanizer Jitter -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Natural Humanizer Jitter (Variasi Acak Anti-Kaku):" FontWeight="SemiBold" Foreground="#8B949E"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPreset.Jitter, StringFormat='{}{0} px'}" FontWeight="Bold" Foreground="#8B949E"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="5" Value="{Binding SelectedPreset.Jitter, UpdateSourceTrigger=PropertyChanged}"
                                SmallChange="1" Margin="0,0,0,16"/>

                        <!-- Checkbox Scope Only -->
                        <CheckBox Content="Mode Scope-Only (Recoil hanya aktif saat Klik Kanan/Aim ditekan)"
                                  IsChecked="{Binding SelectedPreset.ScopeOnly, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="#E6EDF3" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <!-- Description / Note -->
                        <TextBlock Text="Catatan &amp; Deskripsi:" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedPreset.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Height="55" TextWrapping="Wrap" AcceptsReturn="True"
                                 Padding="8,6" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="0,0,0,16"/>

                        <!-- Reset Default Button -->
                        <Button Command="{Binding ResetDefaultsCommand}"
                                Content="🔄 Reset Seluruh Preset ke Bawaan Point Blank"
                                Padding="12,6" HorizontalAlignment="Left"
                                Background="#21262D" Foreground="#8B949E" BorderBrush="#30363D" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Console Text -->
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>

                <!-- Hotkey Legend -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hotkey: " FontSize="11" Foreground="#6E7681"/>
                    <TextBlock Text="[F6] ON/OFF Recoil  |  [F7] Ganti Senjata  |  [F8] HUD Overlay" FontSize="11" FontWeight="SemiBold" Foreground="#00F0FF"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
