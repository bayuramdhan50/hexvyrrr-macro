<Window x:Class="PbRecoil.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PbRecoil.Views"
        Title="Point Blank Auto-Tap &amp; Anti-Recoil"
        Width="360" Height="Auto" SizeToContent="Height"
        MinWidth="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="30" Top="30"
        ShowInTaskbar="True">

    <Window.Resources>
        <converters:StatusBorderConverter x:Key="StatusBorderConverter"/>
        <converters:StatusBgConverter     x:Key="StatusBgConverter"/>
        <converters:StatusTextConverter   x:Key="StatusTextConverter"/>
        <converters:FiringColorConverter  x:Key="FiringColorConverter"/>
        <BooleanToVisibilityConverter     x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Root Border with Glassmorphism Effect -->
    <Border CornerRadius="14"
            BorderThickness="1.5"
            BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"
            Margin="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0090E17" Offset="0"/>
                <GradientStop Color="#F00F1724" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.85"/>
        </Border.Effect>

        <StackPanel>
            <!-- ── TITLE BAR (Draggable) ────────────────────────────────── -->
            <Border CornerRadius="14,14,0,0"
                    Padding="16,12,12,12"
                    Background="#141B26"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Margin="0,0,10,0"
                                 Fill="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                  Color="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}"
                                                  Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="PB AUTO-TAP" FontWeight="Black" FontSize="13"
                                   Foreground="#00F0FF" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text=" // HARDCODED" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize & Close) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="—" Width="24" Height="24" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8B949E" FontSize="11" Cursor="Hand"
                                ToolTip="Minimize ke System Tray"
                                Click="MinimizeButton_Click"/>

                        <Button Content="✕" Width="24" Height="24"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8B949E" FontSize="12" Cursor="Hand"
                                ToolTip="Tutup Aplikasi"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── NEON DIVIDER ────────────────────────────────────────── -->
            <Border Height="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ── MAIN CONTENT ────────────────────────────────────────── -->
            <StackPanel Margin="20,18,20,20">
                
                <!-- Status Badge [ ON / OFF ] -->
                <Border HorizontalAlignment="Center"
                        CornerRadius="10"
                        Padding="36,10"
                        Margin="0,0,0,14"
                        Background="{Binding IsEngineActive, Converter={StaticResource StatusBgConverter}}"
                        BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"
                        BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                          Color="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}"
                                          Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="ENGINE " FontSize="22" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusHeader}"
                                   FontSize="26" FontWeight="Black"
                                   Foreground="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>

                <!-- Live Tapping Status Pulse Indicator -->
                <Border CornerRadius="6" Background="#121824" BorderBrush="#212936" BorderThickness="1"
                        Padding="10,6" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="8" Height="8" Margin="2,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding IsFiring, Converter={StaticResource FiringColorConverter}}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                  Color="{Binding IsFiring, Converter={StaticResource FiringColorConverter}}"
                                                  Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   FontSize="11" Foreground="#C9D1D9"
                                   FontFamily="Segoe UI"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Hardcoded Calibration Specs -->
                <TextBlock Text="KALIBRASI HARDCODE POINT BLANK" FontSize="9" FontWeight="Bold"
                           Foreground="#4E5766" Margin="2,0,0,6" FontFamily="Segoe UI"/>

                <WrapPanel Margin="0,0,0,16">
                    <Border Background="#161F2E" CornerRadius="4" Padding="8,3" Margin="0,0,6,6" BorderBrush="#263447" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Rate: " FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="35ms / 35ms" FontSize="10" FontWeight="Bold" Foreground="#00FF88"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#161F2E" CornerRadius="4" Padding="8,3" Margin="0,0,6,6" BorderBrush="#263447" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Recoil: " FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="-5 px (Smooth)" FontSize="10" FontWeight="Bold" Foreground="#00F0FF"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#161F2E" CornerRadius="4" Padding="8,3" Margin="0,0,6,6" BorderBrush="#263447" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Jitter: " FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="±1 px" FontSize="10" FontWeight="Bold" Foreground="#E6EDF3"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#161F2E" CornerRadius="4" Padding="8,3" Margin="0,0,6,6" BorderBrush="#263447" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Timer: " FontSize="10" Foreground="#8B949E"/>
                            <TextBlock Text="1ms Period" FontSize="10" FontWeight="Bold" Foreground="#FFA500"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Hotkey Instructions Card -->
                <Border Background="#0C121C" CornerRadius="8" Padding="14,10" BorderBrush="#1F2838" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PANDUAN KONTROL" FontSize="9" FontWeight="Bold" Foreground="#4E5766" Margin="0,0,0,6"/>

                        <!-- Hotkey F1 -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1A2332" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                <TextBlock Text="[ F1 ]" FontSize="10" FontWeight="Bold" Foreground="#00FF88" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Toggle Engine ON / OFF" FontSize="11" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Hotkey F2 -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1A2332" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                <TextBlock Text="[ F2 ]" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Tampilkan / Sembunyikan HUD Overlay" FontSize="11" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Hold Action -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1A2332" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                <TextBlock Text="[ HOLD ]" FontSize="10" FontWeight="Bold" Foreground="#FF5500" FontFamily="Consolas"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Tahan Klik Kiri (LMB) -> Auto-Tap + Recoil" FontSize="11" Foreground="#E6EDF3" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>
