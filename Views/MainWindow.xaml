<Window x:Class="PbRecoil.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PbRecoil.Views"
        xmlns:vm="clr-namespace:PbRecoil.ViewModels"
        Title="Hexvyrr Macro — Point Blank Precision Engine"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        Width="420" Height="Auto" SizeToContent="Height"
        MinWidth="390"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="30" Top="30"
        ShowInTaskbar="True">

    <Window.Resources>
        <converters:StatusBorderConverter x:Key="StatusBorderConverter"/>
        <converters:StatusBgConverter     x:Key="StatusBgConverter"/>
        <converters:StatusTextConverter   x:Key="StatusTextConverter"/>
        <converters:FiringColorConverter  x:Key="FiringColorConverter"/>
        <converters:PresetActiveBgConverter x:Key="PresetActiveBgConv"/>
        <converters:PresetActiveFgConverter x:Key="PresetActiveFgConv"/>
        <converters:ModeActiveBgConverter   x:Key="ModeActiveBgConv"/>
        <converters:ModeActiveFgConverter   x:Key="ModeActiveFgConv"/>
        <converters:ModeActiveBorderConverter x:Key="ModeActiveBorderConv"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter     x:Key="BoolToVis"/>

        <!-- Cyber Action Button Style -->
        <Style x:Key="CyberActionBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#131D2B"/>
            <Setter Property="BorderBrush" Value="#22334A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Primary Button Style -->
        <Style x:Key="CyberPrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#182A2E"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root Border with Glassmorphism Effect -->
    <Border CornerRadius="14"
            BorderThickness="1.5"
            BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"
            Margin="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4090E17" Offset="0"/>
                <GradientStop Color="#F40E1624" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#000000" Opacity="0.92"/>
        </Border.Effect>

        <StackPanel>
            <!-- ── TITLE BAR ────────────────────────────────────────────── -->
            <Border CornerRadius="14,14,0,0"
                    Padding="12,10,12,10"
                    Background="#141B26"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="5" Margin="0,0,8,0" ClipToBounds="True" Background="#0C121C">
                            <Image Source="pack://application:,,,/Resources/app_logo.png" Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock Text="HEXVYRR MACRO" FontWeight="Black" FontSize="13"
                                   Foreground="#00F0FF" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="MULTI-WEAPON" FontSize="8.5" FontWeight="Bold" Foreground="#00FF88" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="24" Height="24" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#00F0FF" FontSize="11" Cursor="Hand"
                                ToolTip="Cek Pembaruan Versi"
                                Click="CheckUpdateButton_Click">
                            <TextBlock Text="🚀" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Content="—" Width="24" Height="24" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8B949E" FontSize="11" Cursor="Hand"
                                ToolTip="Minimize ke System Tray"
                                Click="MinimizeButton_Click"/>

                        <Button Content="✕" Width="24" Height="24"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8B949E" FontSize="12" Cursor="Hand"
                                ToolTip="Tutup Aplikasi"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Rectangle Height="1" Fill="#1E2D42"/>

            <!-- ── MAIN CONTENT BODY ───────────────────────────────────── -->
            <StackPanel Margin="14,12,14,14">

                <!-- ── STATUS HERO CARD ────────────────────────────────── -->
                <Border CornerRadius="8"
                        Background="#0D1420"
                        BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="#141E2D" BorderBrush="#25354D" BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Width="14" Height="14"
                                     Fill="{Binding IsFiring, Converter={StaticResource FiringColorConverter}}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                      Color="{Binding IsFiring, Converter={StaticResource FiringColorConverter}}"
                                                      Opacity="0.95"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontWeight="Bold" FontSize="10.5" Foreground="#E6EDF3"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ModeName}"
                                       FontSize="9" FontWeight="SemiBold" Foreground="#00F0FF" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="{Binding StatusHeader}"
                                Width="50" Height="26" Margin="8,0,0,0"
                                Command="{Binding ToggleEngineCommand}"
                                Style="{StaticResource CyberPrimaryBtn}"
                                Background="{Binding IsEngineActive, Converter={StaticResource StatusBgConverter}}"
                                Foreground="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}"
                                BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"/>
                    </Grid>
                </Border>

                <!-- ── SECTION 1: NO RECOIL (ASSAULT / SMG) ──────────────────── -->
                <Border CornerRadius="7" Background="#0C121C" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⚡ NO RECOIL (ASSAULT / SMG)" FontSize="10" FontWeight="Black" Foreground="#00F0FF" Margin="0,0,0,6"/>
                        
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="⚡ Auto-Tap AR/SMG"
                                    Height="26" Margin="0,0,2,0"
                                    Command="{Binding SelectModeCommand}"
                                    CommandParameter="AssaultNoRecoil"
                                    Style="{StaticResource CyberActionBtn}"
                                    HorizontalContentAlignment="Center"
                                    FontWeight="Bold"
                                    Background="{Binding SelectedMode, Converter={StaticResource ModeActiveBgConv}, ConverterParameter=AssaultNoRecoil}"
                                    Foreground="{Binding SelectedMode, Converter={StaticResource ModeActiveFgConv}, ConverterParameter=AssaultNoRecoil}"
                                    BorderBrush="{Binding SelectedMode, Converter={StaticResource ModeActiveBorderConv}, ConverterParameter=AssaultNoRecoil}"/>

                            <Button Grid.Column="1" Content="💥 AUG A3 / HBAR"
                                    Height="26" Margin="2,0,0,0"
                                    Command="{Binding SelectModeCommand}"
                                    CommandParameter="AugA3"
                                    Style="{StaticResource CyberActionBtn}"
                                    HorizontalContentAlignment="Center"
                                    FontWeight="Bold"
                                    Background="{Binding SelectedMode, Converter={StaticResource ModeActiveBgConv}, ConverterParameter=AugA3}"
                                    Foreground="{Binding SelectedMode, Converter={StaticResource ModeActiveFgConv}, ConverterParameter=AugA3}"
                                    BorderBrush="{Binding SelectedMode, Converter={StaticResource ModeActiveBorderConv}, ConverterParameter=AugA3}"/>
                        </Grid>

                        <!-- Hold & Release Custom Timers for No-Recoil -->
                        <Grid Margin="0,2,0,0" Visibility="{Binding IsNoRecoilMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                <TextBlock Text="{Binding HoldMs, StringFormat=Hold: {0}ms}" FontSize="8.5" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{x:Static vm:MainViewModel.HoldPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="2" Columns="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Margin="1" Height="18" FontSize="8"
                                                    Command="{Binding DataContext.SetHoldMsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CyberActionBtn}"
                                                    Foreground="{Binding Converter={StaticResource PresetActiveFgConv}, RelativeSource={RelativeSource Self}}"
                                                    Background="{Binding Converter={StaticResource PresetActiveBgConv}, RelativeSource={RelativeSource Self}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                <TextBlock Text="{Binding ReleaseMs, StringFormat=Release: {0}ms}" FontSize="8.5" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{x:Static vm:MainViewModel.ReleasePresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="2" Columns="5"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Margin="1" Height="18" FontSize="8"
                                                    Command="{Binding DataContext.SetReleaseMsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CyberActionBtn}"
                                                    Foreground="{Binding Converter={StaticResource PresetActiveFgConv}, RelativeSource={RelativeSource Self}}"
                                                    Background="{Binding Converter={StaticResource PresetActiveBgConv}, RelativeSource={RelativeSource Self}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <!-- AUG Smooth Pull-Down Recoil Controls -->
                        <Border Margin="0,4,0,0" Padding="6,6" Background="#080D14" CornerRadius="5" BorderBrush="#162233" BorderThickness="1"
                                Visibility="{Binding IsAugMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎯 Smooth Pull-Down (Sumbu Y):" FontSize="8.5" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AugPullStatusLabel}" FontSize="9" FontWeight="Black" Foreground="#00F0FF" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Stepper & Slider Control -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="-" Width="24" Height="20" Margin="0,0,6,0"
                                            Command="{Binding DecreaseAugPullCommand}"
                                            Style="{StaticResource CyberActionBtn}" FontSize="11" FontWeight="Black"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                            Value="{Binding AugPullDown, Mode=TwoWay}"
                                            VerticalAlignment="Center" Foreground="#00F0FF"/>
                                    <Button Grid.Column="2" Content="+" Width="24" Height="20" Margin="6,0,0,0"
                                            Command="{Binding IncreaseAugPullCommand}"
                                            Style="{StaticResource CyberActionBtn}" FontSize="11" FontWeight="Black"/>
                                </Grid>

                                <!-- Presets Quick Buttons -->
                                <ItemsControl ItemsSource="{x:Static vm:MainViewModel.AugPullPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="2" Columns="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Margin="1" Height="18" FontSize="8"
                                                    Command="{Binding DataContext.SetAugPullCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CyberActionBtn}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="* Sesuai Logitech AUG: 8 peluru (Scope) / 5 peluru (Hipfire) dengan Smooth Pull-Down, dilanjutkan Sustained Spray stabil."
                                           FontSize="7.5" Foreground="#6E7681" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── SECTION 2: AWP & SG (QUICK CHANGE MACRO) ─────────────── -->
                <Border CornerRadius="7" Background="#0C121C" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎯 SNIPER &amp; SHOTGUN (QUICK CHANGE MACRO)" FontSize="10" FontWeight="Black" Foreground="#00FF88" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="[F7] In-Game Switch" FontSize="9" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Sub-Section A: WEAPON SELECTION -->
                        <TextBlock Text="WEAPON / JENIS SENJATA:" FontSize="8.5" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🎯 ALL SNIPER" Height="28" Margin="0,0,2,0"
                                    Command="{Binding SelectWeaponCommand}" CommandParameter="AllSniper"
                                    Style="{StaticResource CyberActionBtn}" FontWeight="Bold"
                                    Background="{Binding SelectedWeapon, Converter={StaticResource ModeActiveBgConv}, ConverterParameter=AllSniper}"
                                    Foreground="{Binding SelectedWeapon, Converter={StaticResource ModeActiveFgConv}, ConverterParameter=AllSniper}"
                                    BorderBrush="{Binding SelectedWeapon, Converter={StaticResource ModeActiveBorderConv}, ConverterParameter=AllSniper}"/>

                            <Button Grid.Column="1" Content="🎯 KAR98K" Height="28" Margin="2,0,2,0"
                                    Command="{Binding SelectWeaponCommand}" CommandParameter="Kar98k"
                                    Style="{StaticResource CyberActionBtn}" FontWeight="Bold"
                                    Background="{Binding SelectedWeapon, Converter={StaticResource ModeActiveBgConv}, ConverterParameter=Kar98k}"
                                    Foreground="{Binding SelectedWeapon, Converter={StaticResource ModeActiveFgConv}, ConverterParameter=Kar98k}"
                                    BorderBrush="{Binding SelectedWeapon, Converter={StaticResource ModeActiveBorderConv}, ConverterParameter=Kar98k}"/>

                            <Button Grid.Column="2" Content="💥 SHOTGUN (SG)" Height="28" Margin="2,0,0,0"
                                    Command="{Binding SelectWeaponCommand}" CommandParameter="Shotgun"
                                    Style="{StaticResource CyberActionBtn}" FontWeight="Bold"
                                    Background="{Binding SelectedWeapon, Converter={StaticResource ModeActiveBgConv}, ConverterParameter=Shotgun}"
                                    Foreground="{Binding SelectedWeapon, Converter={StaticResource ModeActiveFgConv}, ConverterParameter=Shotgun}"
                                    BorderBrush="{Binding SelectedWeapon, Converter={StaticResource ModeActiveBorderConv}, ConverterParameter=Shotgun}"/>
                        </Grid>

                        <!-- Sub-Section B: QC MODE SELECTION -->
                        <TextBlock Text="QC MODE / KECEPATAN QUICK CHANGE:" FontSize="8.5" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Normal (No QC)" Height="26" Margin="0,0,2,0"
                                    Command="{Binding SelectQcCommand}" CommandParameter="Normal"
                                    Style="{StaticResource CyberActionBtn}" FontWeight="SemiBold"
                                    Background="{Binding SelectedQcLevel, Converter={StaticResource ModeActiveBgConv}, ConverterParameter=Normal}"
                                    Foreground="{Binding SelectedQcLevel, Converter={StaticResource ModeActiveFgConv}, ConverterParameter=Normal}"
                                    BorderBrush="{Binding SelectedQcLevel, Converter={StaticResource ModeActiveBorderConv}, ConverterParameter=Normal}"/>

                            <Button Grid.Column="1" Content="QC 50%" Height="26" Margin="2,0,2,0"
                                    Command="{Binding SelectQcCommand}" CommandParameter="Qc50"
                                    Style="{StaticResource CyberActionBtn}" FontWeight="SemiBold"
                                    Background="{Binding SelectedQcLevel, Converter={StaticResource ModeActiveBgConv}, ConverterParameter=Qc50}"
                                    Foreground="{Binding SelectedQcLevel, Converter={StaticResource ModeActiveFgConv}, ConverterParameter=Qc50}"
                                    BorderBrush="{Binding SelectedQcLevel, Converter={StaticResource ModeActiveBorderConv}, ConverterParameter=Qc50}"/>

                            <Button Grid.Column="2" Content="QC 75% (Fast)" Height="26" Margin="2,0,0,0"
                                    Command="{Binding SelectQcCommand}" CommandParameter="Qc75"
                                    Style="{StaticResource CyberActionBtn}" FontWeight="SemiBold"
                                    Background="{Binding SelectedQcLevel, Converter={StaticResource ModeActiveBgConv}, ConverterParameter=Qc75}"
                                    Foreground="{Binding SelectedQcLevel, Converter={StaticResource ModeActiveFgConv}, ConverterParameter=Qc75}"
                                    BorderBrush="{Binding SelectedQcLevel, Converter={StaticResource ModeActiveBorderConv}, ConverterParameter=Qc75}"/>
                        </Grid>

                        <!-- Visual Sequence Flow (Dynamic By Mode) -->
                        <Border Background="#080C14" CornerRadius="6" Padding="6,6" Margin="0,0,0,4" BorderBrush="#162233" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                
                                <!-- No Recoil Mode Flow -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsNoRecoilMode, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#5A0D1B" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                        <TextBlock Text="LMB ↓" FontWeight="Bold" FontSize="8.5" Foreground="#FFFFFF"/>
                                    </Border>
                                    <TextBlock Text="{Binding HoldMs, StringFormat=' ➔ {0}ms ➔ '}" FontSize="8" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                                    <Border Background="#5A0D1B" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                        <TextBlock Text="LMB ↑" FontWeight="Bold" FontSize="8.5" Foreground="#FFFFFF"/>
                                    </Border>
                                    <TextBlock Text="{Binding ReleaseMs, StringFormat=' ➔ {0}ms ➔ '}" FontSize="8" FontWeight="Bold" Foreground="#00FF88" VerticalAlignment="Center"/>
                                    <Border Background="#162233" CornerRadius="3" Padding="4,2" VerticalAlignment="Center">
                                        <TextBlock Text="↻ LOOP" FontSize="8" FontWeight="Black" Foreground="#8B949E"/>
                                    </Border>
                                </StackPanel>

                                <!-- AUG Mode Flow -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsAugMode, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#5A0D1B" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="Fire + J (59ms)" FontSize="8" FontWeight="Bold" Foreground="#FF8899"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#162D4A" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="{Binding AugPullStatusLabel, StringFormat='Burst Y: {0}'}" FontSize="8" FontWeight="Bold" Foreground="#00F0FF"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#123B22" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="Rel (9ms)" FontSize="8" FontWeight="Bold" Foreground="#00FF88"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#162233" CornerRadius="3" Padding="4,2"><TextBlock Text="↻ SUSTAINED SPRAY" FontSize="7.5" FontWeight="Black" Foreground="#8B949E"/></Border>
                                </StackPanel>

                                <!-- All Sniper Mode Flow -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsAllSniperMode, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#5A0D1B" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="LMB/N (25ms)" FontSize="8" FontWeight="Bold" Foreground="#FF8899"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#3B2610" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="3 (15ms)" FontSize="8" FontWeight="Bold" Foreground="#FFA500"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#3B1435" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="Q (15ms)" FontSize="8" FontWeight="Bold" Foreground="#FF6BFF"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#123B22" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="1 (15ms)" FontSize="8" FontWeight="Bold" Foreground="#00FF88"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#162233" CornerRadius="3" Padding="4,2"><TextBlock Text="LMB/N ↑" FontSize="7.5" FontWeight="Bold" Foreground="#8B949E"/></Border>
                                </StackPanel>

                                <!-- Kar Mode Flow -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsKarMode, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#162D4A" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="RMB/J (Scope)" FontSize="8" FontWeight="Bold" Foreground="#00F0FF"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#5A0D1B" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="LMB/N (Fire)" FontSize="8" FontWeight="Bold" Foreground="#FF8899"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#3B2610" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="3" FontSize="8" FontWeight="Bold" Foreground="#FFA500"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#3B1435" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="Q" FontSize="8" FontWeight="Bold" Foreground="#FF6BFF"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#123B22" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="1" FontSize="8" FontWeight="Bold" Foreground="#00FF88"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="1,0"/>
                                    <Border Background="#162233" CornerRadius="3" Padding="4,2"><TextBlock Text="RELEASE" FontSize="7.5" FontWeight="Bold" Foreground="#8B949E"/></Border>
                                </StackPanel>

                                <!-- SG Mode Flow -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSgMode, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#5A0D1B" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="LMB/N (Fire)" FontSize="8" FontWeight="Bold" Foreground="#FF8899"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="2,0"/>
                                    <Border Background="#3B2610" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="3 (Melee)" FontSize="8" FontWeight="Bold" Foreground="#FFA500"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="2,0"/>
                                    <Border Background="#123B22" CornerRadius="3" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="1 (SG)" FontSize="8" FontWeight="Bold" Foreground="#00FF88"/></Border>
                                    <TextBlock Text="➔" FontSize="7.5" Foreground="#6E7681" VerticalAlignment="Center" Margin="2,0"/>
                                    <Border Background="#162233" CornerRadius="3" Padding="4,2"><TextBlock Text="↻ RECOVERY" FontSize="7.5" FontWeight="Black" Foreground="#8B949E"/></Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding ModeDescription}" FontSize="9" Foreground="#8B949E" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ── SECTION 3: CROSSHAIR ─────────────────────────────────── -->
                <Border CornerRadius="7" Background="#0C121C" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🎯 CROSSHAIR" FontSize="10" FontWeight="Black" Foreground="#FF6BFF" Margin="0,0,0,6"/>
                        
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Adaptive Center Crosshair Dot" FontSize="10" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                                <TextBlock Text="Posisi presisi di titik tengah layar game Point Blank" FontSize="9" Foreground="#6E7681" Margin="0,1,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                     Content="{Binding CrosshairStatusLabel, StringFormat=DOT: {0}}"
                                     Height="24" Width="70"
                                     Command="{Binding ToggleCrosshairCommand}"
                                     Style="{StaticResource CyberActionBtn}"
                                     Foreground="{Binding IsCrosshairVisible, Converter={StaticResource PresetActiveFgConv}}"
                                     Background="{Binding IsCrosshairVisible, Converter={StaticResource PresetActiveBgConv}}"
                                     BorderBrush="#2A3B52"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── SECTION 4: CONFIG PROFILE MANAGEMENT ────────────── -->
                <Border CornerRadius="7" Background="#0C121C" BorderBrush="#1C2738" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📁 CONFIG PROFILE" FontSize="10" FontWeight="Black" Foreground="#FF6BFF" Margin="0,0,0,6"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="💾 SAVE"
                                    Margin="0,0,3,0"
                                    Command="{Binding SaveConfigCommand}"
                                    Style="{StaticResource CyberPrimaryBtn}"
                                    ToolTip="Simpan konfigurasi saat ini ke hexvyrr_config.json"/>

                            <Button Grid.Column="1"
                                    Content="📂 LOAD"
                                    Margin="3,0,3,0"
                                    Command="{Binding LoadConfigCommand}"
                                    Style="{StaticResource CyberActionBtn}"
                                    ToolTip="Muat konfigurasi dari hexvyrr_config.json"/>

                            <Button Grid.Column="2"
                                    Content="↺ DEFAULT"
                                    Margin="3,0,0,0"
                                    Command="{Binding ResetDefaultConfigCommand}"
                                    Style="{StaticResource CyberActionBtn}"
                                    ToolTip="Kembalikan semua pengaturan ke nilai default pabrik"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── SHORTCUT GUIDELINE FOOTER ───────────────────────── -->
                <Border Background="#090E17" CornerRadius="6" Padding="8,6" BorderBrush="#192333" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="[ F5 ]" FontWeight="Bold" FontSize="10" Foreground="#00F0FF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Engine On/Off" FontSize="8.5" Foreground="#6E7681" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="[ F6 ]" FontWeight="Bold" FontSize="10" Foreground="#00FF88" HorizontalAlignment="Center"/>
                            <TextBlock Text="HUD Overlay" FontSize="8.5" Foreground="#6E7681" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="[ F7 ]" FontWeight="Bold" FontSize="10" Foreground="#FF6BFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Config Menu" FontSize="8.5" Foreground="#6E7681" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>

