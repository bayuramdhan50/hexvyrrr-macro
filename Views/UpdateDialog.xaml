<Window x:Class="PbRecoil.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pembaruan Hexvyrr Macro"
        Width="420" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Cyber Action Button Style -->
        <Style x:Key="CyberActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#131D2B"/>
            <Setter Property="BorderBrush" Value="#22334A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Primary Button Style -->
        <Style x:Key="CyberPrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#10252C"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon Progress Bar Style -->
        <Style x:Key="CyberProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#0A101A"/>
            <Setter Property="BorderBrush" Value="#1C2E47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00F0FF" Offset="0"/>
                                            <GradientStop Color="#00FF88" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14"
            BorderThickness="1.5"
            BorderBrush="#00F0FF"
            Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8080E17" Offset="0"/>
                <GradientStop Color="#F80C1422" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#00F0FF" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content / Changelog -->
                <RowDefinition Height="Auto"/> <!-- Progress Section -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- ── TITLE BAR ─────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    CornerRadius="14,14,0,0"
                    Padding="14,10"
                    Background="#141E2D"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PEMBARUAN TERSEDIA" FontWeight="Black" FontSize="12"
                                   Foreground="#00F0FF" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Width="24" Height="24"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#8B949E" FontSize="12" Cursor="Hand"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ── MAIN CONTENT (VERSION & CHANGELOG) ────────────────── -->
            <StackPanel Grid.Row="1" Margin="14,12,14,6">
                <!-- Version Comparison Badge -->
                <Border Background="#0C131F" BorderBrush="#1C2F4A" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Versi Saat Ini" FontSize="9" Foreground="#6E7681" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtCurrentVersion" Text="v1.0.0" FontWeight="Bold" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="➔" FontSize="14" FontWeight="Bold" Foreground="#00FF88" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Versi Terbaru" FontSize="9" Foreground="#00FF88" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtLatestVersion" Text="v1.1.0" FontWeight="Black" FontSize="13" Foreground="#00FF88" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Changelog Header -->
                <TextBlock Text="Catatan Rilis / Changelog:" FontSize="10" FontWeight="Bold" Foreground="#C9D1D9" Margin="2,0,0,4"/>

                <!-- Changelog Box -->
                <Border Background="#070B12" BorderBrush="#162233" BorderThickness="1" CornerRadius="6" Height="100" Padding="8,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtReleaseNotes"
                                   Text="• Peningkatan performa recoil engine&#x0a;• Perbaikan bug hotkey F1-F3&#x0a;• Fitur auto-update mandiri"
                                   FontSize="10" Foreground="#8B949E" TextWrapping="Wrap" LineHeight="15"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- ── PROGRESS BAR SECTION (VISIBLE DURING DOWNLOAD) ────── -->
            <StackPanel Grid.Row="2" x:Name="ProgressSection" Visibility="Collapsed" Margin="14,0,14,10">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatus" Text="Mengunduh berkas..." FontSize="9.5" FontWeight="SemiBold" Foreground="#00F0FF"/>
                    <TextBlock Grid.Column="1" x:Name="TxtPercentage" Text="0%" FontSize="10" FontWeight="Bold" Foreground="#00FF88"/>
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource CyberProgressBarStyle}" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>

            <!-- ── ACTION BUTTONS ────────────────────────────────────── -->
            <Border Grid.Row="3" Background="#0A101A" CornerRadius="0,0,14,14" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnDownloadAndInstall"
                            Content="⚡ DOWNLOAD &amp; PASANG SEKARANG"
                            Margin="0,0,8,0"
                            Style="{StaticResource CyberPrimaryBtn}"
                            Click="BtnDownloadAndInstall_Click"/>

                    <Button Grid.Column="1" x:Name="BtnCancel"
                            Content="Nanti Saja"
                            Style="{StaticResource CyberActionBtn}"
                            Click="BtnCancel_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
