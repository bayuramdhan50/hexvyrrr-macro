<Window x:Class="PbRecoil.Views.PresetEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preset Senjata PB - Editor"
        Width="480" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        Foreground="#F0F6FC"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="PENGATURAN PRESET SENJATA" FontWeight="Bold" FontSize="16" Foreground="#00F0FF"/>
            <TextBlock Text="Konfigurasi parameter recoil kompensasi mouse" FontSize="11" Foreground="#8B949E"/>
        </StackPanel>

        <!-- Form Elements -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Weapon Name -->
                <TextBlock Text="Nama Senjata:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#E6EDF3"/>
                <TextBox x:Name="TxtName" Padding="8,6" Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="0,0,0,12"/>

                <!-- Category -->
                <TextBlock Text="Kategori Senjata:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#E6EDF3"/>
                <ComboBox x:Name="CmbCategory" Padding="8,6" Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="0,0,0,12"/>

                <!-- Vertical Recoil (Y Drag) -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Vertical Recoil (Y Drag):" FontWeight="SemiBold" Foreground="#00FF88"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SliderVertical, StringFormat='{}{0:0}'}" FontWeight="Bold" Foreground="#00FF88"/>
                </Grid>
                <Slider x:Name="SliderVertical" Minimum="0" Maximum="25" SmallChange="1" LargeChange="2" Margin="0,0,0,12"/>

                <!-- Horizontal Recoil (X Bias) -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Horizontal Bias (X Drag):" FontWeight="SemiBold" Foreground="#00F0FF"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SliderHorizontal, StringFormat='{}{0:0}'}" FontWeight="Bold" Foreground="#00F0FF"/>
                </Grid>
                <Slider x:Name="SliderHorizontal" Minimum="-10" Maximum="10" SmallChange="1" LargeChange="2" Margin="0,0,0,12"/>

                <!-- Delay / Fire Rate Interval -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fire Interval Delay (ms):" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SliderDelay, StringFormat='{}{0:0} ms'}" FontWeight="Bold" Foreground="#E6EDF3"/>
                </Grid>
                <Slider x:Name="SliderDelay" Minimum="2" Maximum="60" SmallChange="1" LargeChange="5" Margin="0,0,0,12"/>

                <!-- Smooth Step -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Smooth Steps (Interpolasi):" FontWeight="SemiBold" Foreground="#8B949E"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SliderSmooth, StringFormat='{}{0:0}'}" FontWeight="Bold" Foreground="#8B949E"/>
                </Grid>
                <Slider x:Name="SliderSmooth" Minimum="1" Maximum="10" SmallChange="1" Margin="0,0,0,12"/>

                <!-- Random Jitter / Humanizer -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Natural Jitter (Humanizer):" FontWeight="SemiBold" Foreground="#8B949E"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=SliderJitter, StringFormat='{}{0:0}'}" FontWeight="Bold" Foreground="#8B949E"/>
                </Grid>
                <Slider x:Name="SliderJitter" Minimum="0" Maximum="5" SmallChange="1" Margin="0,0,0,12"/>

                <!-- Scope Only Checkbox -->
                <CheckBox x:Name="ChkScopeOnly" Content="Hanya aktif saat Klik Kanan (Scope / Aim) ditekan" 
                          Foreground="#E6EDF3" Margin="0,0,0,12"/>

                <!-- Description -->
                <TextBlock Text="Deskripsi / Catatan:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#8B949E"/>
                <TextBox x:Name="TxtDescription" Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                         Padding="8,6" Background="#161B22" Foreground="#F0F6FC" BorderBrush="#30363D" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Batal" Width="90" Height="32" Margin="0,0,8,0"
                    Background="#21262D" Foreground="#8B949E" BorderBrush="#30363D"
                    Click="BtnCancel_Click"/>
            <Button Content="Simpan Preset" Width="120" Height="32"
                    Background="#00FF88" Foreground="#0D1117" FontWeight="Bold" BorderThickness="0"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
