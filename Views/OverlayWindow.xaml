<Window x:Class="PbRecoil.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PbRecoil.Views"
        Title="PB Recoil HUD Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="260" Height="96"
        Left="24" Top="24"
        IsHitTestVisible="False">

    <Window.Resources>
        <converters:StatusBorderConverter x:Key="StatusBorderConverter"/>
        <converters:StatusBgConverter     x:Key="StatusBgConverter"/>
        <converters:StatusTextConverter   x:Key="StatusTextConverter"/>
        <converters:FiringColorConverter  x:Key="FiringColorConverter"/>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="#E60A0E17"
            BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"
            BorderThickness="1.5"
            Padding="12,10"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#000000" Opacity="0.9"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             Fill="{Binding IsFiring, Converter={StaticResource FiringColorConverter}}">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                              Color="{Binding IsFiring, Converter={StaticResource FiringColorConverter}}"
                                              Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="PB AUTO-TAP" FontWeight="ExtraBold" Foreground="#00F0FF" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text=" // HUD" Foreground="#6E7681" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" CornerRadius="4" Padding="8,2"
                        Background="{Binding IsEngineActive, Converter={StaticResource StatusBgConverter}}"
                        BorderBrush="{Binding IsEngineActive, Converter={StaticResource StatusBorderConverter}}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding StatusHeader}" 
                               FontWeight="Black" FontSize="10"
                               Foreground="{Binding IsEngineActive, Converter={StaticResource StatusTextConverter}}"/>
                </Border>
            </Grid>

            <!-- Calibration Pill Badges -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <Border Background="#141B26" CornerRadius="3" Padding="5,1" Margin="0,0,4,0" BorderBrush="#212C3D" BorderThickness="1">
                    <TextBlock Text="35ms Tap" FontSize="9" FontWeight="SemiBold" Foreground="#00FF88"/>
                </Border>
                <Border Background="#141B26" CornerRadius="3" Padding="5,1" Margin="0,0,4,0" BorderBrush="#212C3D" BorderThickness="1">
                    <TextBlock Text="-5px Recoil" FontSize="9" FontWeight="SemiBold" Foreground="#00F0FF"/>
                </Border>
                <Border Background="#141B26" CornerRadius="3" Padding="5,1" Margin="0,0,4,0" BorderBrush="#212C3D" BorderThickness="1">
                    <TextBlock Text="±1px Jitter" FontSize="9" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                </Border>
            </StackPanel>

            <!-- Footer Hotkeys Guide -->
            <TextBlock Grid.Row="2" Text="[F1] ON/OFF  |  [F2] Toggle HUD  |  [HOLD LMB]"
                       FontSize="9" Foreground="#6E7681" Margin="0,4,0,0"/>
        </Grid>
    </Border>
</Window>
